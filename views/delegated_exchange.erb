<a class="usa-skipnav" href="#main-content">Skip to main content</a>
 <div class="padding-2 bg-accent-warm text-base-lightest font-mono-xs text-center">
  <p>TEST Do not use real personal information (demo purposes only) TEST</p>
</div>
<div class="padding-2 bg-primary-darker text-base-lightest font-mono-xs text-center">
  <img class="width-2" aria-hidden="true" src="vendor/identity-design-system/assets/img/us_flag_small.png" alt="U.S. flag">
  A DEMO website of the United States government
</div>
<%== erb :header, locals: { user_email: nil } %>
<main id="main-content">
  <div class="grid-container">
    <div class="grid-row grid-gap">
      <div class="usa-overlay"></div>
      <div class="grid-container padding-0">
        <h1>Delegated Exchange Test</h1>

        <% if third_party_delegated_login_occurred %>
          <div class="usa-alert usa-alert--success usa-alert--slim margin-bottom-2" data-third-party-delegated-login>
            <div class="usa-alert__body">
              <p class="usa-alert__text">
                Third-party delegated login completed.
              </p>
            </div>
          </div>
        <% end %>

        <% if access_token %>
          <p>
            Delegated access token type: <code><%= token_type %></code><%= bound ? ', bound to this sign-in\'s DPoP key; the API call carries a proof' : '' %>
          </p>
          <% if bound %>
            <div class="usa-alert usa-alert--success usa-alert--slim margin-bottom-2" data-dpop-bound-token>
              <div class="usa-alert__body">
                <p class="usa-alert__text">
                  DPoP is live: this delegated access token is bound to this session's DPoP key.
                </p>
              </div>
            </div>
          <% end %>
          <p>
            Delegated access token:
            <code class="display-block text-wrap"><%= access_token %></code>
          </p>

          <form action="/send-access-token" method="POST">
            <%== csrf_tag %>
            <label class="usa-label" for="target">
              Target issuer
            </label>
            <select name="target" id="target" class="usa-select">
              <% targets.each do |target| %>
                <option value="<%= target.issuer %>" <%= 'selected' if selected_target == target.issuer %>>
                  <%= target.issuer %>
                </option>
              <% end %>
            </select>

            <button type="submit" class="usa-button margin-top-2">
              Send brokered request
            </button>
          </form>
        <% end %>

        <% if result %>
          <h2>Target response</h2>
          <dl>
            <dt>URL</dt>
            <dd><code><%= result[:url] || result['url'] %></code></dd>
            <dt>Status</dt>
            <dd><code><%= result[:status] || result['status'] %></code></dd>
            <dt>Headers</dt>
            <dd><pre><%= JSON.pretty_generate(result[:headers] || result['headers']) %></pre></dd>
            <dt>Body</dt>
            <dd><pre><%= result[:body] || result['body'] %></pre></dd>
          </dl>
        <% else %>
          <hr>
          <div class="margin-top-2">
            <p>Start a sign-in that requests a delegated access token for the configured target.</p>
            <form action="/delegated_exchange/request" method="GET">
              <label class="usa-label" for="target">
                Target issuer
              </label>
              <select name="target" id="target" class="usa-select">
                <% targets.each do |target| %>
                  <option value="<%= target.issuer %>" <%= 'selected' if selected_target == target.issuer %>>
                    <%= target.issuer %>
                  </option>
                <% end %>
              </select>
              <div class="usa-checkbox margin-top-2">
                <input class="usa-checkbox__input" id="use-dpop" type="checkbox" name="use_dpop" value="true">
                <label class="usa-checkbox__label" for="use-dpop">Use DPoP key binding</label>
              </div>
               <div class="usa-checkbox">
                  <input class="usa-checkbox__input" id="immediately-begin-login-request" type="checkbox" name="immediately_begin_third_party_login" value="true">
                  <label class="usa-checkbox__label" for="immediately-begin-login-request">Immediately begin third party login request if there is no identity</label>
                </div>
              <button class="usa-button margin-top-2 margin-bottom-2" type="submit">Request secure access token</button>
            </form>

            <% if targets.any? %>
              <hr>
              <p>Test third-party initiated login for a target application.</p>
              <form action="/delegated_exchange/third_party_login" method="GET">
                <label class="usa-label" for="third-party-target">
                  Target issuer
                </label>
                <select name="target" id="third-party-target" class="usa-select">
                  <% targets.each do |target| %>
                    <option value="<%= target.issuer %>" <%= 'selected' if selected_target == target.issuer %>>
                      <%= target.issuer %>
                    </option>
                  <% end %>
                </select>
                <div class="usa-checkbox margin-top-2">
                  <input class="usa-checkbox__input" id="immediately-begin-delegation-request" type="checkbox" name="immediately_begin_delegation" value="true">
                  <label class="usa-checkbox__label" for="immediately-begin-delegation-request">Immediately begin delegation request after return</label>
                </div>
                <button class="usa-button usa-button--secondary margin-top-2 margin-bottom-2" type="submit">
                  Start third-party initiated login
                </button>
              </form>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</main>
