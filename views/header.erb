<header class="usa-header usa-header--basic" role="banner">
  <div class="usa-nav-container">
    <div class="usa-navbar">
      <div class="usa-logo" id="extended-logo">
        <em class="usa-logo__text">
          <a href="/" title="Home" aria-label="Home">Department of Housing Support (OIDC resource server demo)</a>
        </em>
      </div>
    </div>
    <nav aria-label="Demo pages" class="margin-left-2">
      <ul class="usa-nav__primary usa-accordion">
        <li class="usa-nav__primary-item"><a class="usa-nav-link" href="/decisions">API decisions</a></li>
        <li class="usa-nav__primary-item"><a class="usa-nav-link" href="/attempts-api">Attempts API</a></li>
        <li class="usa-nav__primary-item"><a class="usa-nav-link" href="/attempts-api?tab=delegated">Delegated sessions</a></li>
      </ul>
    </nav>
    <nav class="usa-nav">
      <section aria-label="Logged in information">
        <div class="display-flex flex-row">
          <div class="flex-align-self-center margin-right-4">
            <%= user_email if user_email %>
          </div>
          <div class="flex-1">
            <% if user_email %>
              <form action="/handle-logout" method="post">
                <button type="submit" class="usa-button usa-button--outline">
                  <%== csrf_tag %>
                  <svg class="usa-icon" aria-hidden="true" focusable="false" role="img">
                    <use xlink:href="/vendor/uswds/img/sprite.svg#login"></use>
                  </svg>
                Log out
              </button>
              </form>
            <% else %>
              <form>
                <button type="submit"  class="usa-button usa-button--outline" form="login-form">
                  <svg class="usa-icon" aria-hidden="true" focusable="false" role="img">
                    <use href="vendor/identity-design-system/assets/img/sprite.svg#login"></use>
                  </svg>
                  Sign in
                </button>
              </form>
            <% end %>
          </div>
        </div>
      </section>
    </nav>
  </div>
</header>
