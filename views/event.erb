
<tr>
  <td>
    <% type = event_data.keys.first.split('/').last %>
    <code><%= type %></code>
    <% if LoginGov::OidcSinatra::DELEGATION_EVENT_TYPES.key?(type) || event_data.values.first&.key?('delegation_id') %>
      <br><span class="usa-tag" title="Part of a delegated session (has delegation_id or actor_issuer)">delegated</span>
    <% end %>
  </td>
  <td>
    <%= jwe_data['jti']%>
    <form action="/ack-events" method="post">
      <input type="hidden" name="jtis" value="<%= jwe_data['jti'] %>">
      <button type="submit" class="usa-button usa-button--secondary">
        <%== csrf_tag %>
        <svg class="usa-icon" aria-hidden="true" focusable="false" role="img">
          <use xlink:href="/vendor/uswds/img/sprite.svg#delete"></use>
        </svg>
        Delete Event
      </button>
    </form>
  </td>
  <td>
    <%= Time.at(jwe_data['iat']) %>
  </td>
  <td style="max-width: 400px;overflow-wrap: anywhere;">
    
    <%= JSON.pretty_generate(event_data(event_data.values)) %>
  </td>
</tr>
