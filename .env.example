# Direct OIDC sign-in (the agency's own web app). One key pair is used for
# sign-in, introspection and Attempts API decryption (config/rs_demo.key).
export acr_values=http://idmanagement.gov/ns/assurance/ial/2
export client_id=urn:gov:gsa:openidconnect:sp:records_agency
export client_id_pkce=urn:gov:gsa:openidconnect:sp:sinatra_pkce
export redirect_uri=http://localhost:9393/
export sp_private_key_path=./config/rs_demo.key
export idp_domain=localhost:3000
export idp_url=http://localhost:3000

# Resource server (delegated access, RFC 7662 introspection)
export RESOURCE_IDENTIFIER=https://records-api.agency.localdev
export RS_PRIVATE_KEY_PATH=./config/rs_demo.key
export INTROSPECTION_CACHE_SECONDS=60

# Attempts API viewer in the agency role
export attempts_shared_secret=records-agency-attempts-secret
export attempts_private_key_path=./config/rs_demo.key
